# Everything is optional. DNS provider tokens and webhooks are added in the UI
# (or API) and stored in the SQLite database, not here.

# Admin token for the UI and /api/*. If unset, one is generated on first start,
# stored in the database and logged once (`mywanip --show-token` prints it).
# Must be at least 32 characters when listening beyond loopback.
# Generate one with: openssl rand -hex 32
# MYWANIP_ADMIN_TOKEN=

# MYWANIP_HOST=127.0.0.1       # bind address when not using Docker (0.0.0.0 for the whole network)
# MYWANIP_BIND=127.0.0.1       # Docker Compose only: host address the port is published on.
#                              # A LAN IP (e.g. 192.168.1.10) or 0.0.0.0 opens it to your network.
# MYWANIP_PORT=8787
# MYWANIP_DATA=                # where mywanip.db lives; default ~/.local/share/mywanip
# MYWANIP_ALLOWED_HOSTS=       # optional Host-header allowlist (DNS-rebinding defence), e.g. pi.local,192.168.1.10
